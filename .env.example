# Copy to .env and fill in. Never commit .env.
RELAY_HOSTNAME=mailrelay01.busse.local
RELAY_DOMAIN=busseinc.com
# Space-separated CIDRs allowed to relay without auth
ALLOWED_NETWORKS=<LAN_CIDR>/21
SMTP2GO_USER=
SMTP2GO_PASS=
# Verify in SMTP2GO docs; 2525 is an alternate port
UPSTREAM=[mail.smtp2go.com]:587
QUEUE_LIFETIME=5d
MESSAGE_SIZE_LIMIT=52428800
# BOUNCE_NOTICE_TO=it@busseinc.com

# ---- Notifications ----
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Comma list of: sent, deferred, bounced, rejected, expired
# (add "sent" to get every delivery; noisy with ERP volume)
DISCORD_NOTIFY=rejected,bounced,expired,deferred
