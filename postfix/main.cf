# Busse mail relay - Postfix main.cf
# Outbound-only smarthost relay: ERP (IP allowlist, no AUTH) -> this box -> SMTP2GO
# Replace every <PLACEHOLDER> before use.

compatibility_level = 3.6
myhostname = <RELAY_FQDN>              # e.g. mailrelay01.busse.local
mydomain = <YOUR_DOMAIN>               # e.g. busseinc.com
myorigin = $mydomain

# Never deliver mail locally - this box only relays
mydestination =
local_recipient_maps =
local_transport = error:local delivery is disabled
alias_maps =
alias_database =

# Listen on LAN (and the keepalived VIP, if used)
inet_interfaces = all
inet_protocols = ipv4

# ---- Who may send through this relay (no SMTP AUTH) ----
# Keep this TIGHT: only the ERP server(s). Add the second node's IP only if needed.
mynetworks = 127.0.0.0/8, <ERP_IP>/32

smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject
smtpd_client_restrictions = permit_mynetworks, reject

# Inbound side: ERP likely can't do TLS, so don't require it
smtpd_tls_security_level = none
smtpd_sasl_auth_enable = no

# ---- Upstream: SMTP2GO ----
# Verify host/port in SMTP2GO docs (587 typical; 2525 alternate)
relayhost = [mail.smtp2go.com]:587
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous
smtp_tls_security_level = encrypt
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

# ---- Queueing: the whole point ----
# Hold mail through SMTP2GO / network outages
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d
queue_run_delay = 300s
minimal_backoff_time = 300s
maximal_backoff_time = 1800s

# ERP attachments (invoices/PDFs) - 50 MB; check SMTP2GO's own limit
message_size_limit = 52428800
mailbox_size_limit = 0

# Notify on bounces/resource problems
notify_classes = bounce, resource, software
# bounce_notice_recipient = it@<YOUR_DOMAIN>

smtpd_banner = $myhostname ESMTP
disable_vrfy_command = yes
